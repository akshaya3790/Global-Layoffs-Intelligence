# Copy this file to .env (same folder) and fill in your own values. Never commit .env.
# These are the standard PostgreSQL client variables; values already set in your shell take priority.
PGHOST=localhost
PGPORT=5432
PGDATABASE=layoffs_db
PGUSER=your_postgres_user
PGPASSWORD=change_me
# Optional: used only by tests/test_phase4_db.py, which creates and then drops its own
# throwaway databases named layoffs_test_<random>. The user needs the CREATEDB privilege.
# LAYOFFS_ENABLE_DB_TESTS=1
