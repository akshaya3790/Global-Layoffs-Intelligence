table repeat_overall

	measure '12-month repeat probability %' = ROUND(MAX(repeat_overall[p_repeat_365d]) * 100, 1)
		formatString: 0.0

	column 'group'
		dataType: string
		summarizeBy: none
		sourceColumn: group

	column 'companies'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: companies

	column 'p_repeat_365d'
		dataType: double
		summarizeBy: none
		sourceColumn: p_repeat_365d

	column 'p_repeat_365d_lo'
		dataType: double
		summarizeBy: none
		sourceColumn: p_repeat_365d_lo

	column 'p_repeat_365d_hi'
		dataType: double
		summarizeBy: none
		sourceColumn: p_repeat_365d_hi

	column 'p_repeat_730d'
		dataType: double
		summarizeBy: none
		sourceColumn: p_repeat_730d

	partition repeat_overall = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(ProjectFolder & "\reports\stats\repeat_probability_overall.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Headers, {"group", "companies", "p_repeat_365d", "p_repeat_365d_lo", "p_repeat_365d_hi", "p_repeat_730d"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"group", type text}, {"companies", Int64.Type}, {"p_repeat_365d", type number}, {"p_repeat_365d_lo", type number}, {"p_repeat_365d_hi", type number}, {"p_repeat_730d", type number}}, "en-US")
				in
				    Typed
