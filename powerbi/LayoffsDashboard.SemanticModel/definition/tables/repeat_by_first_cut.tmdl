table repeat_by_first_cut

	column 'group'
		dataType: string
		summarizeBy: none
		sourceColumn: group

	column 'companies'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: companies

	column 'repeats_observed'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: repeats_observed

	column 'p_repeat_365d'
		dataType: double
		summarizeBy: none
		sourceColumn: p_repeat_365d

	column 'p_repeat_365d_lo'
		dataType: double
		summarizeBy: none
		sourceColumn: p_repeat_365d_lo

	column 'p_repeat_365d_hi'
		dataType: double
		summarizeBy: none
		sourceColumn: p_repeat_365d_hi

	partition repeat_by_first_cut = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(ProjectFolder & "\reports\stats\repeat_probability_by_first_cut_size.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Headers, {"group", "companies", "repeats_observed", "p_repeat_365d", "p_repeat_365d_lo", "p_repeat_365d_hi"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"group", type text}, {"companies", Int64.Type}, {"repeats_observed", Int64.Type}, {"p_repeat_365d", type number}, {"p_repeat_365d_lo", type number}, {"p_repeat_365d_hi", type number}}, "en-US")
				in
				    Typed
