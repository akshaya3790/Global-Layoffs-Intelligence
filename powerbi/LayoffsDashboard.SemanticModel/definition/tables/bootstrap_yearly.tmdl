table bootstrap_yearly

	column 'event_year'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: event_year

	column 'events'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: events

	column 'events_lo'
		dataType: double
		summarizeBy: none
		sourceColumn: events_lo

	column 'events_hi'
		dataType: double
		summarizeBy: none
		sourceColumn: events_hi

	column 'disclosed_jobs'
		dataType: double
		summarizeBy: none
		sourceColumn: disclosed_jobs

	column 'disclosed_jobs_lo'
		dataType: double
		summarizeBy: none
		sourceColumn: disclosed_jobs_lo

	column 'disclosed_jobs_hi'
		dataType: double
		summarizeBy: none
		sourceColumn: disclosed_jobs_hi

	partition bootstrap_yearly = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(ProjectFolder & "\reports\stats\bootstrap_yearly.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Headers, {"event_year", "events", "events_lo", "events_hi", "disclosed_jobs", "disclosed_jobs_lo", "disclosed_jobs_hi"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"event_year", Int64.Type}, {"events", Int64.Type}, {"events_lo", type number}, {"events_hi", type number}, {"disclosed_jobs", type number}, {"disclosed_jobs_lo", type number}, {"disclosed_jobs_hi", type number}}, "en-US")
				in
				    Typed
